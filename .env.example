# UEW Innovation Hub environment template.
# Copy to .env for local development:  cp .env.example .env && php artisan key:generate
# Production values for Render and Vercel are in docs/deployment.md.

APP_NAME="UEW Innovation Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Comma-separated proxy IPs, or * behind a trusted platform load balancer (Render, Vercel).
TRUSTED_PROXIES=

# --- Database ---------------------------------------------------------------
# Local: SQLite (database/database.sqlite). Production: PostgreSQL or MySQL.
DB_CONNECTION=sqlite
# DB_URL=postgresql://user:password@host:5432/uew_innovation_hub?sslmode=require
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=uew_innovation_hub
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sessions, cache, queue -------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true in production (HTTPS only cookies).
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
# CACHE_PREFIX=
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Redis (optional, recommended once traffic grows: CACHE_STORE / SESSION_DRIVER / QUEUE_CONNECTION=redis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Documents (project reports, publication PDFs, grant proposals) -----------
# "private" = storage/app/private on local disk. "s3" = any S3-compatible bucket
# (AWS S3, Cloudflare R2, Backblaze B2). Required on Vercel and free Render.
DOCUMENTS_DISK=private
MAX_UPLOAD_KB=20480
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Mail ---------------------------------------------------------------------
# "log" writes emails to storage/logs. Use smtp (or resend/postmark/ses) in production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="innovationhub@uew.edu.gh"
MAIL_FROM_NAME="${APP_NAME}"

# --- Hub settings -------------------------------------------------------------
HUB_CONTACT_EMAIL=innovationhub@uew.edu.gh
METRICS_CACHE_TTL=300

# First Hub Director, created by `php artisan hub:create-admin` (runs on every
# container boot; does nothing once an active Hub Director exists).
ADMIN_EMAIL=
ADMIN_NAME="Hub Director"
ADMIN_PASSWORD=

# Demo data (`php artisan db:seed`). Never enable on a site holding real data.
SEED_PASSWORD=password
SEED_DEMO_DATA=false

VITE_APP_NAME="${APP_NAME}"
