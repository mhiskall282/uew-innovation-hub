/* =========================================================
   NEW ORGANISATION
========================================================= */

function toggleNewOrganization(
    button
) {

    const row =
        button.closest(
            '.organization-row'
        );


    const select =
        row.querySelector(
            'select[name="organization_id[]"]'
        );


    const box =
        row.querySelector(
            '.new-org-box'
        );


    const input =
        box.querySelector(
            'input[name="new_organization[]"]'
        );


    if (
        box.classList.contains('show')
    ) {

        box.classList.remove(
            'show'
        );


        select.disabled =
            false;


        input.value =
            '';


        input.required =
            false;


        button.textContent =
            '+ Enter New Organisation';

    } else {

        box.classList.add(
            'show'
        );


        select.value =
            '';


        select.disabled =
            true;


        input.required =
            true;


        button.textContent =
            '− Use Existing Organisation';
    }
}


/* =========================================================
   ADD FORM SUBMISSION
========================================================= */

document.getElementById(
    'addProjectForm'
).addEventListener(
    'submit',
    async function(event) {

        event.preventDefault();


        const form =
            this;


        const button =
            document.getElementById(
                'addSubmitButton'
            );


        const message =
            document.getElementById(
                'addMessage'
            );


        button.disabled =
            true;


        button.textContent =
            'Adding Project...';


        message.style.display =
            'none';


        try {

            const formData =
                new FormData(form);


            formData.set(
                'ajax',
                '1'
            );


            const response =
                await fetch(
                    'add_project.php',
                    {
                        method: 'POST',
                        body: formData
                    }
                );


            const responseText =
                await response.text();


            console.log(
                'ADD PHP RESPONSE:',
                responseText
            );


            if (
                !responseText.trim()
            ) {

                throw new Error(
                    'add_project.php returned an empty response.'
                );
            }


            let data;


            try {

                data =
                    JSON.parse(
                        responseText
                    );

            } catch (error) {

                throw new Error(
                    'add_project.php returned invalid JSON: ' +
                    responseText
                );
            }


            if (!data.success) {

                throw new Error(
                    data.message ||
                    'Unable to add project.'
                );
            }


            message.innerHTML =
                `

                <div
                    style="
                        padding:13px;
                        background:#f0fdf4;
                        color:#166534;
                        border-left:
                            4px solid #22c55e;
                        border-radius:7px;
                    "
                >
                    ✓
                    ${escapeHTML(
                        data.message
                    )}
                </div>

                `;


            message.style.display =
                'block';


            setTimeout(
                function() {

                    window.location.reload();

                },
                700
            );


        } catch (error) {

            message.innerHTML =
                `

                <div
                    style="
                        padding:13px;
                        background:#fef2f2;
                        color:#991b1b;
                        border-left:
                            4px solid #ef4444;
                        border-radius:7px;
                    "
                >
                    ${escapeHTML(
                        error.message
                    )}
                </div>

                `;


            message.style.display =
                'block';


            button.disabled =
                false;


            button.textContent =
                '✓ Add Project';
        }

    }
);


