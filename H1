/* =========================================================
   MODAL HELPERS
========================================================= */

function openModal(id) {

    const modal =
        document.getElementById(id);

    if (!modal) {
        return;
    }

    modal.classList.add('show');

    document.body.style.overflow =
        'hidden';
}


function closeModal(id) {

    const modal =
        document.getElementById(id);

    if (!modal) {
        return;
    }

    modal.classList.remove('show');

    if (
        !document.querySelector(
            '.modal.show'
        )
    ) {

        document.body.style.overflow =
            '';
    }
}


function closeModalOutside(
    event,
    id
) {

    if (
        event.target.id === id
    ) {

        closeModal(id);
    }
}


document.addEventListener(
    'keydown',
    function(event) {

        if (
            event.key === 'Escape'
        ) {

            document.querySelectorAll(
                '.modal.show'
            ).forEach(
                function(modal) {

                    modal.classList.remove(
                        'show'
                    );

                }
            );

            document.body.style.overflow =
                '';
        }

    }
);


/* =========================================================
   FIND PROJECT
========================================================= */

function findProject(id) {

    return projects.find(
        function(project) {

            return String(
                project['project ID']
            ) === String(id);

        }
    );
}


/* =========================================================
   VIEW PROJECT
========================================================= */

function openViewModal(id) {

    const project =
        findProject(id);

    if (!project) {
        return;
    }


    let organisationsHTML =
        'No organisation linked.';


    if (
        project.relationships &&
        project.relationships.length
    ) {

        organisationsHTML =
            project.relationships
                .map(
                    function(org) {

                        return `
                            <div
                                style="
                                    padding:8px 0;
                                    border-bottom:
                                        1px solid #e5e7eb;
                                "
                            >

                                <strong>
                                    ${escapeHTML(
                                        org.organization_name
                                    )}
                                </strong>

                                <span
                                    style="
                                        color:#6b7280;
                                    "
                                >
                                    —
                                    ${escapeHTML(
                                        org.role
                                    )}
                                </span>

                            </div>
                        `;

                    }
                )
                .join('');
    }


    let reportHTML =
        `
            <div class="report-box">

                <strong>
                    Project Report
                </strong>

                <div
                    style="
                        margin-top:10px;
                        color:#6b7280;
                    "
                >
                    No report uploaded.
                </div>

            </div>
        `;


    if (
        project['Project Report']
    ) {

        const report =
            project[
                'Project Report'
            ];


        reportHTML =
            `
                <div class="report-box">

                    <strong>
                        Project Report
                    </strong>

                    <div
