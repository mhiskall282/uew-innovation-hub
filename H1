    }
}


/* =========================================================
   FORMAT DATE
========================================================= */

function formatDate(
    date
) {

    if (!date) {

        return 'Not specified';
    }


    const parts =
        String(date).split('-');


    if (
        parts.length !== 3
    ) {

        return escapeHTML(
            date
        );
    }


    const dateObject =
        new Date(
            date + 'T00:00:00'
        );


    const month =
        dateObject.toLocaleString(
            'en',
            {
                month: 'short'
            }
        );


    return (
        parts[2] +
        ' ' +
        month +
        ' ' +
        parts[0]
    );
}


/* =========================================================
   SECURITY HELPERS
========================================================= */

function escapeHTML(
    value
) {

    if (
        value === null ||
        value === undefined
    ) {

        return '';
    }


    return String(value)
        .replace(
            /&/g,
            '&amp;'
        )
        .replace(
            /</g,
            '&lt;'
        )
        .replace(
            />/g,
            '&gt;'
        )
        .replace(
            /"/g,
            '&quot;'
        )
        .replace(
            /'/g,
            '&#039;'
        );
}


function escapeAttribute(
    value
) {

    return escapeHTML(
        value
    );
}


