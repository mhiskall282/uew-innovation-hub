 <?php

/* =========================================================
   DATABASE CONNECTION
========================================================= */

$servername = "localhost";
$username   = "root";
$password   = "mysql";
$database   = "project_mysql";

$conn = new mysqli(
    $servername,
    $username,
    $password,
    $database
);

if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}


/* =========================================================
   DASHBOARD STATISTICS
========================================================= */

$total_projects = 0;
$total_organisations = 0;
$total_beneficiaries = 0;
$total_linked_projects = 0;


/* TOTAL PROJECTS */
$result = $conn->query(
    "SELECT COUNT(*) AS total
     FROM innovation_hub"
);

if ($result) {
    $row = $result->fetch_assoc();
    $total_projects = (int)($row['total'] ?? 0);
}


/* TOTAL ORGANISATIONS */
$result = $conn->query(
    "SELECT COUNT(*) AS total
     FROM organization"
);

if ($result) {
    $row = $result->fetch_assoc();
    $total_organisations = (int)($row['total'] ?? 0);
}


/* TOTAL BENEFICIARIES */
$result = $conn->query(
    "SELECT COALESCE(
                SUM(`Number of Beneficiaries`),
                0
            ) AS total
     FROM innovation_hub"
);

if ($result) {
    $row = $result->fetch_assoc();
    $total_beneficiaries =
        (int)($row['total'] ?? 0);
}


/* LINKED PROJECTS */
$result = $conn->query(
    "SELECT COUNT(
                DISTINCT project_id
            ) AS total
     FROM project_organisations"
);

if ($result) {
    $row = $result->fetch_assoc();
    $total_linked_projects =
        (int)($row['total'] ?? 0);
}


/* =========================================================
   LOAD ORGANISATIONS
========================================================= */

$organizations = [];

$organization_result = $conn->query(
    "SELECT
        organization_id,
        organization_name
     FROM organization
     ORDER BY organization_name ASC"
);

if ($organization_result) {

    while (
        $row =
        $organization_result->fetch_assoc()
    ) {

        $organizations[] = $row;
    }
}


/* =========================================================
   LOAD PROJECTS
========================================================= */

$projects = [];

$project_sql = "
    SELECT
        ih.`project ID`,
        ih.`Project Title`,
        ih.`Number of Beneficiaries`,
        ih.`Start Date`,
        ih.`End Date`,
        ih.`Project Report`,

        GROUP_CONCAT(
            DISTINCT CONCAT(
                COALESCE(
                    o.organization_name,
                    ''
                ),
                '||',
                COALESCE(
                    po.role,
                    ''
                )
            )
            ORDER BY
                o.organization_name
            SEPARATOR ';;'
        ) AS organization_data

    FROM innovation_hub ih

    LEFT JOIN project_organisations po
        ON ih.`project ID` = po.project_id

    LEFT JOIN organization o
        ON po.organization_id =
           o.organization_id

    GROUP BY
        ih.`project ID`,
        ih.`Project Title`,
        ih.`Number of Beneficiaries`,
        ih.`Start Date`,
        ih.`End Date`,
        ih.`Project Report`

    ORDER BY
        ih.`project ID` ASC
";


$project_result =
    $conn->query($project_sql);


if ($project_result) {

    while (
        $project =
        $project_result->fetch_assoc()
    ) {

        $project_id =
            (int)$project['project ID'];

        $relationships = [];


        /* =================================================
           LOAD ALL PROJECT RELATIONSHIPS
        ================================================= */

        $relationship_stmt =
            $conn->prepare(
                "SELECT
                    po.organization_id,
                    po.role,
                    o.organization_name

                 FROM project_organisations po

                 LEFT JOIN organization o
                    ON po.organization_id =
                       o.organization_id

                 WHERE po.project_id = ?

                 ORDER BY
                    po.role,
                    o.organization_name"
            );


        if ($relationship_stmt) {

            $relationship_stmt->bind_param(
                "i",
                $project_id
            );

            $relationship_stmt->execute();

            $relationship_result =
                $relationship_stmt->get_result();


            while (
                $relationship =
                $relationship_result->fetch_assoc()
            ) {

                $relationships[] = [
                    'organization_id' =>
                        (int)(
                            $relationship[
                                'organization_id'
                            ] ?? 0
                        ),

                    'organization_name' =>
                        $relationship[
                            'organization_name'
                        ] ?? '',

                    'role' =>
                        $relationship[
                            'role'
                        ] ?? ''
                ];
            }


            $relationship_stmt->close();
        }


        $project['relationships'] =
            $relationships;


        $projects[] = $project;
    }
}


/* =========================================================
   GROUP PROJECTS BY YEAR
========================================================= */

$grouped_projects = [];

foreach (
    $projects
    as $project
) {

    $start_date =
        $project['Start Date'] ?? '';

    if (
        !empty($start_date) &&
        preg_match(
            '/^\d{4}-\d{2}-\d{2}$/',
            $start_date
        )
    ) {

        $year =
            substr(
                $start_date,
                0,
                4
            );

    } else {

        $year = 'No Date';
    }


    if (
        !isset(
            $grouped_projects[$year]
        )
    ) {

        $grouped_projects[$year] = [];
    }


    $grouped_projects[$year][] =
        $project;
}


/* =========================================================
   SORT YEARS
========================================================= */

$dated_years = [];

foreach (
    array_keys($grouped_projects)
    as $year
) {

    if ($year !== 'No Date') {

        $dated_years[] =
            (int)$year;
    }
}


rsort($dated_years);


$sorted_grouped_projects = [];

foreach (
    $dated_years
    as $year
) {

    $year = (string)$year;

    $sorted_grouped_projects[$year] =
        $grouped_projects[$year];
}


if (
    isset(
        $grouped_projects['No Date']
    )
) {

    $sorted_grouped_projects['No Date'] =
        $grouped_projects['No Date'];
}


$grouped_projects =
    $sorted_grouped_projects;

?>
