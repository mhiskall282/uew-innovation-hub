/* =========================================================
   CREATE ORGANISATION ROW
========================================================= */

function createOrganizationRowHTML(
    type,
    index,
    selectedId = '',
    selectedRole = '',
    existingNewOrg = ''
) {

    let options =
        `

        <option value="">
            -- Select Existing Organisation --
        </option>

        `;


    organizations.forEach(
        function(org) {

            const selected =
                String(
                    org.organization_id
                ) ===
                String(selectedId)
                ?
                'selected'
                :
                '';


            options +=
                `

                <option
                    value="${escapeAttribute(
                        org.organization_id
                    )}"
                    ${selected}
                >
                    ${escapeHTML(
                        org.organization_name
                    )}
                </option>

                `;
        }
    );


    const sponsorSelected =
        selectedRole ===
        'Sponsor'
        ?
        'selected'
        :
        '';


    const partnerSelected =
        selectedRole ===
        'Partner'
        ?
        'selected'
        :
        '';


    const organizerSelected =
        selectedRole ===
        'Organizer'
        ?
        'selected'
        :
        '';


    return `

        <div
            class="organization-row"
            data-org-row="${type}-${index}"
        >

            <div class="organization-grid">

                <div>

                    <div class="field">

                        <label>
                            Organisation
                        </label>

                        <select
                            name="organization_id[]"
                            class="${type}-organization-select"
                        >

                            ${options}

                        </select>

                    </div>


                    <button
                        type="button"
                        class="new-org-toggle"
                        onclick="toggleNewOrganization(this)"
                    >
                        + Enter New Organisation
                    </button>


                    <div class="new-org-box">

                        <div class="field">

                            <label>
                                New Organisation Name
                            </label>

                            <input
                                type="text"
                                name="new_organization[]"
                                value="${escapeAttribute(
                                    existingNewOrg
                                )}"
                                placeholder="Enter organisation name"
                            >

                        </div>

                    </div>

                </div>


                <div>

                    <div class="field">

                        <label>
                            Role
                        </label>

                        <select
                            name="role[]"
                            required
                        >

                            <option value="">
                                -- Select Role --
                            </option>

                            <option
                                value="Sponsor"
                                ${sponsorSelected}
                            >
                                Sponsor
                            </option>

                            <option
                                value="Partner"
                                ${partnerSelected}
                            >
                                Partner
                            </option>

                            <option
                                value="Organizer"
                                ${organizerSelected}
                            >
                                Organizer
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <div class="org-tools">

                <span
                    style="
                        font-size:12px;
                        color:#6b7280;
                    "
                >
                    Select an existing organisation
                    or enter a new one.
                </span>


                ${
                    index > 0
                    ?
                    `
                    <button
                        type="button"
                        class="remove-org"
                        onclick="removeOrganizationRow(this)"
                    >
                        Remove
                    </button>
                    `
                    :
                    ''
                }

            </div>

        </div>

    `;
}


