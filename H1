/* =========================================================
   EDIT FORM SUBMISSION
========================================================= */

document.getElementById(
    'editProjectForm'
).addEventListener(
    'submit',
    async function(event) {

        event.preventDefault();


        const form =
            this;


        const button =
            form.querySelector(
                'button[type="submit"]'
            );


        const message =
            document.getElementById(
                'editMessage'
            );


        button.disabled =
            true;


        button.textContent =
            'Saving Changes...';


        try {

            const formData =
                new FormData(form);


            formData.set(
                'ajax',
                '1'
            );


            const response =
                await fetch(
                    'edit_project.php',
                    {
                        method: 'POST',
                        body: formData
                    }
                );


            const responseText =
                await response.text();


            console.log(
                'EDIT PHP RESPONSE:',
                responseText
            );


            if (
                !responseText.trim()
            ) {

                throw new Error(
                    'edit_project.php returned an empty response.'
                );
            }


            let data;


            try {

                data =
                    JSON.parse(
                        responseText
                    );

            } catch (error) {

                throw new Error(
                    'edit_project.php returned invalid JSON: ' +
                    responseText
                );
            }


            if (!data.success) {

                throw new Error(
                    data.message ||
                    'Unable to update project.'
                );
            }


            message.innerHTML =
                `

                <div
                    style="
                        padding:13px;
                        background:#f0fdf4;
                        color:#166534;
                        border-left:
                            4px solid #22c55e;
                        border-radius:7px;
                    "
                >
                    ✓
                    ${escapeHTML(
                        data.message
                    )}
                </div>

                `;


            message.style.display =
                'block';


            setTimeout(
                function() {

                    window.location.reload();

                },
                700
            );


        } catch (error) {

            message.innerHTML =
                `

                <div
                    style="
                        padding:13px;
                        background:#fef2f2;
                        color:#991b1b;
                        border-left:
                            4px solid #ef4444;
                        border-radius:7px;
                    "
                >
                    ${escapeHTML(
                        error.message
                    )}
                </div>

                `;


            message.style.display =
                'block';


            button.disabled =
                false;


            button.textContent =
                '✓ Save Changes';
        }

    }
);


