/* =========================================================
   SEARCH
========================================================= */

function searchProjects() {

    const query =
        document.getElementById(
            'searchInput'
        ).value
            .trim()
            .toLowerCase();


    const cards =
        document.querySelectorAll(
            '.project-card'
        );


    let visible =
        0;


    cards.forEach(
        function(card) {

            const text =
                card.dataset.search ||
                '';


            if (
                text.includes(query)
            ) {

                card.style.display =
                    '';

                visible++;

            } else {

                card.style.display =
                    'none';
            }

        }
    );


    document.querySelectorAll(
        '.year-group'
    ).forEach(
        function(group) {

            const visibleCards =
                group.querySelectorAll(
                    '.project-card:not([style*="display: none"])'
                );


            group.style.display =
                visibleCards.length
                ?
                ''
                :
                'none';
        }
    );


    const noResults =
        document.getElementById(
            'noSearchResults'
        );


    if (noResults) {

        noResults.style.display =
            visible === 0
            ?
            'block'
            :
            'none';
    }


    document.getElementById(
        'searchInfo'
    ).textContent =
        'Showing ' +
        visible +
        ' project' +
        (
            visible === 1
            ?
            ''
            :
            's'
        );
}


function clearSearch() {

    document.getElementById(
        'searchInput'
    ).value =
        '';


    searchProjects();
}


