{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0",
            "memory": 1024,
            "maxDuration": 30
        }
    },
    "routes": [
        { "src": "/build/(.*)", "dest": "/build/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
        { "src": "/images/(.*)", "dest": "/images/$1" },
        { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "LOG_CHANNEL": "stderr",
        "TRUSTED_PROXIES": "*",
        "SESSION_DRIVER": "database",
        "SESSION_SECURE_COOKIE": "true",
        "CACHE_STORE": "database",
        "QUEUE_CONNECTION": "sync",
        "DOCUMENTS_DISK": "s3",
        "APP_CONFIG_CACHE": "/tmp/storage/config.php",
        "APP_EVENTS_CACHE": "/tmp/storage/events.php",
        "APP_PACKAGES_CACHE": "/tmp/storage/packages.php",
        "APP_ROUTES_CACHE": "/tmp/storage/routes.php",
        "APP_SERVICES_CACHE": "/tmp/storage/services.php",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views"
    }
}
